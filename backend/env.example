# Database
DATABASE_URL="postgresql://user:password@localhost:5432/catering_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
FRONTEND_URL="http://localhost:3000"

# Vercel deployment (optional)
# BLOB_READ_WRITE_TOKEN=   # image uploads (Vercel Blob)
# ADMIN_EMAIL= / ADMIN_PASSWORD=   # creates the first admin during the Vercel build if no such user exists
