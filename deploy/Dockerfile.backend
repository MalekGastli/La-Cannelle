# API (Express + Prisma). Build context: repository root.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/ ./
RUN npx prisma generate && npm run build
ENV NODE_ENV=production PORT=3001 UPLOAD_DIR=/data/uploads
EXPOSE 3001
# On every start: apply database migrations, make sure the owner account and first-run content exist, then serve.
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx prisma/ensure-admin.ts && npx tsx prisma/ensure-defaults.ts && node dist/src/server.js"]
