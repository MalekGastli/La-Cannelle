# Website (Next.js). Build context: repository root.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# NEXT_PUBLIC_* values are baked into the pages at build time (legal notice, Instagram, captcha site key)
ARG NEXT_PUBLIC_LEGAL_COMPANY_NAME
ARG NEXT_PUBLIC_LEGAL_FORM
ARG NEXT_PUBLIC_LEGAL_OWNER
ARG NEXT_PUBLIC_LEGAL_EMAIL
ARG NEXT_PUBLIC_LEGAL_PHONE
ARG NEXT_PUBLIC_LEGAL_REGISTER_COURT
ARG NEXT_PUBLIC_LEGAL_REGISTER_NUMBER
ARG NEXT_PUBLIC_LEGAL_VAT_ID
ARG NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER
ARG NEXT_PUBLIC_LEGAL_ARBITRATION
ARG NEXT_PUBLIC_LEGAL_HOSTING_NAME
ARG NEXT_PUBLIC_LEGAL_HOSTING_ADDRESS
ARG NEXT_PUBLIC_LEGAL_HOSTING_LOCATION
ARG NEXT_PUBLIC_INSTAGRAM_HANDLE
ARG NEXT_PUBLIC_INSTAGRAM_PROFILE_URL
ARG NEXT_PUBLIC_INSTAGRAM_POST_URLS
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NEXT_PUBLIC_LEGAL_COMPANY_NAME=$NEXT_PUBLIC_LEGAL_COMPANY_NAME \
    NEXT_PUBLIC_LEGAL_FORM=$NEXT_PUBLIC_LEGAL_FORM \
    NEXT_PUBLIC_LEGAL_OWNER=$NEXT_PUBLIC_LEGAL_OWNER \
    NEXT_PUBLIC_LEGAL_EMAIL=$NEXT_PUBLIC_LEGAL_EMAIL \
    NEXT_PUBLIC_LEGAL_PHONE=$NEXT_PUBLIC_LEGAL_PHONE \
    NEXT_PUBLIC_LEGAL_REGISTER_COURT=$NEXT_PUBLIC_LEGAL_REGISTER_COURT \
    NEXT_PUBLIC_LEGAL_REGISTER_NUMBER=$NEXT_PUBLIC_LEGAL_REGISTER_NUMBER \
    NEXT_PUBLIC_LEGAL_VAT_ID=$NEXT_PUBLIC_LEGAL_VAT_ID \
    NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER=$NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER \
    NEXT_PUBLIC_LEGAL_ARBITRATION=$NEXT_PUBLIC_LEGAL_ARBITRATION \
    NEXT_PUBLIC_LEGAL_HOSTING_NAME=$NEXT_PUBLIC_LEGAL_HOSTING_NAME \
    NEXT_PUBLIC_LEGAL_HOSTING_ADDRESS=$NEXT_PUBLIC_LEGAL_HOSTING_ADDRESS \
    NEXT_PUBLIC_LEGAL_HOSTING_LOCATION=$NEXT_PUBLIC_LEGAL_HOSTING_LOCATION \
    NEXT_PUBLIC_INSTAGRAM_HANDLE=$NEXT_PUBLIC_INSTAGRAM_HANDLE \
    NEXT_PUBLIC_INSTAGRAM_PROFILE_URL=$NEXT_PUBLIC_INSTAGRAM_PROFILE_URL \
    NEXT_PUBLIC_INSTAGRAM_POST_URLS=$NEXT_PUBLIC_INSTAGRAM_POST_URLS \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
RUN npm run build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start"]
