# Copy to ".env" in this folder (cp env.example .env) and fill in. NEVER commit .env.

# Your domain WITHOUT https:// and without www (its DNS A record must point to the server IP first)
DOMAIN=la-cannelle.de

# Random values: openssl rand -hex 24   (database)   /   openssl rand -base64 48   (JWT_SECRET)
POSTGRES_PASSWORD=
JWT_SECRET=

# Owner account (created on the first start)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contact form: where messages go, and the mail account that sends them
CONTACT_RECEIVER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Legal notice / privacy policy (see docs/LEGAL_CHECKLIST.md). Changing these requires: docker compose up -d --build
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_OWNER=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=
NEXT_PUBLIC_LEGAL_REGISTER_COURT=
NEXT_PUBLIC_LEGAL_REGISTER_NUMBER=
NEXT_PUBLIC_LEGAL_VAT_ID=
NEXT_PUBLIC_LEGAL_EMAIL_PROVIDER=
# Hosting provider named in the privacy policy (defaults to STRATO)
#NEXT_PUBLIC_LEGAL_HOSTING_NAME=STRATO AG
#NEXT_PUBLIC_LEGAL_HOSTING_ADDRESS=Otto-Ostrowski-Straße 7, 10249 Berlin
#NEXT_PUBLIC_LEGAL_HOSTING_LOCATION=Rechenzentrum in Deutschland

# Only for emergencies (owner password reset): reset:NewPassword  -> start once, then set back to disabled
ADMIN_FORCE_PASSWORD=disabled
