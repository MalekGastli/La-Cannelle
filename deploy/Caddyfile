# Caddy terminates HTTPS (free Let's Encrypt certificate, renewed automatically) and routes traffic.
{$DOMAIN} {
	encode zstd gzip

	# Uploaded photos are served straight from the API container
	@uploads path /api/uploads/*
	handle @uploads {
		reverse_proxy backend:3001 {
			header_up -X-Vercel-Forwarded-For
		}
	}

	# Everything else is the website (its /api proxy talks to the API container internally)
	handle {
		reverse_proxy frontend:3000 {
			# Caddy sets X-Forwarded-For to the real visitor address; never trust a forged Vercel header
			header_up -X-Vercel-Forwarded-For
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
